# =============================================================================
# Docker Environment — GRM
# =============================================================================
# Ce fichier est utilisé par docker-compose via env_file.
# Ne PAS modifier .env (destiné au développement local avec php artisan serve).

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=GRM
APP_ENV=production
APP_KEY=base64:c5An6/FbK/jWRnNbHO2hVnFY4AbCxtXPS7ZbWP1IdnA=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=GRMdb
DB_USERNAME=devops
DB_PASSWORD=devops

# ─── Session / Queue / Cache ──────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Mail (log pour le dev) ──────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=${APP_NAME}

# ─── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME=${APP_NAME}
